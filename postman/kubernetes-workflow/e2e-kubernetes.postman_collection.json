  "item": [
    {
      "name": "Gateway API End-to-End Flow Copy",
      "item": [
        {
          "name": "1. register user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"User registered successfully\", function () {",
                  "    try {",
                  "        pm.response.to.have.status(201);",
                  "        console.log(\"PASSED: User registered successfully\");",
                  "    } catch (error) {",
                  "        const message = `User registration failed: expected status 201, received ${pm.response.code}. Response: ${pm.response.text().substring(0, 300)}`;",
                  "        console.error(message);",
                  "        throw new Error(message);",
                  "    }",
                  "});",
                  "",
                  "// Extrae el token solo cuando la respuesta es JSON y contiene accessToken",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.accessToken, \"Registration response must include accessToken\").to.exist;",
                  "    pm.environment.set(\"accessToken\", response.accessToken);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstName\": \"Neymar\",\r\n    \"lastName\": \"Santos\",\r\n    \"email\": \"ramdon-user22@gmail.com\",\r\n    \"password\": \"12345678\"\r\n  }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order created successfully\", function () {",
                  "    try {",
                  "        pm.response.to.have.status(201);",
                  "        const response = pm.response.json();",
                  "        pm.expect(response.orderId, \"Creation response must include orderId\").to.exist;",
                  "        pm.environment.set(\"orderId\", response.orderId);",
                  "        console.log(`PASSED: Order created successfully (${response.orderId})`);",
                  "    } catch (error) {",
                  "        const message = `Order creation failed: expected status 201 with orderId, received ${pm.response.code}. Response: ${pm.response.text().substring(0, 300)}`;",
                  "        console.error(message);",
                  "        throw new Error(message);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"items\": [\r\n      { \"productId\": \"P0001\", \"quantity\": 1 },\r\n      { \"productId\": \"P0002\", \"quantity\": 2 }\r\n    ]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "response": []
        },
